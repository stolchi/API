NODE_ENV=development
PORT=4000

# Defaults match ../docker-compose.yml (port 5433 avoids clashing with a local Postgres).
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=stolchi
DATABASE_PASSWORD=stolchi
DATABASE_NAME=stolchi

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-chars

# Comma-separated origins of app/, menu-app/ and the landing site.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Password given to the demo users created by `npm run seed`. Seeding is refused in production.
SEED_PASSWORD=change-me-locally

# Public address of menu-app/, encoded into table QR codes.
MENU_APP_URL=http://localhost:5174

# Where uploaded images are stored when using local disk storage.
UPLOAD_DIR=uploads

# Encrypts Telegram bot tokens at rest. Generate with: openssl rand -base64 32
TELEGRAM_TOKEN_KEY=
